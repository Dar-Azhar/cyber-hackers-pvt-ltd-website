{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The contact form's backend. The site reaches it through its service binding only: no public
  // address, no previews.
  "name": "cyber-hackers-pvt-ltd-www-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "workers_dev": false,
  "preview_urls": false,
  // Enquiries. 
  "d1_databases": [{"binding":"DB","database_name":"cyber-hackers-pvt-ltd-www-enquiries","database_id":"b93ac967-06bb-424d-91a5-7a2d21ee125c","migrations_dir":"migrations"}],
  "vars": {
    "SITE_NAME": "Cyber Hackers Pvt Ltd",
    "SITE_ID": "cyber-hackers-pvt-ltd",
    // Where enquiries are emailed: keep it the same as forms.inbox in sites/main/site.config.ts.
    "FORM_INBOX": "dev.darazhar@gmail.com",
    "GATEWAY_URL": "https://gateway.craeft.org"
  }
  // Secrets (wrangler secret put): TURNSTILE_SECRET_KEY, FORMS_KEY.
}
